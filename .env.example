# MongoDB Atlas connection string (used by Prisma)
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE"

# Secret key required in the x-admin-key header for admin routes (League area)
ADMIN_KEY="change-me"

# Clash of Clans API token (https://developer.clashofclans.com)
CLASH_API_KEY="your-clash-api-token"